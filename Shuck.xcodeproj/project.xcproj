        { "path": "<PRODUCTS>/Shuck.app", "id": "C3A63EA430979383004C0504", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ShuckTests.xctest", "id": "C3A63EB330979384004C0504", "type": "wrapper.cfbundle", "index": false },
